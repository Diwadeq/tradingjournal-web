//@version=6
// =====================================================================
//  FVG + PDH/L + Killzones + NY Open + ICT SMT + Confluence + Bias + OB
//  --------------------------------------------------------------------
//  SMT v5: sweep-rule pairing, invalidation fading, memory-based.
//  Order Blocks: body-only box (open→close) on displacement candles.
// =====================================================================
indicator('FVG, PDH/L, Killzones, NY Open, SMT & Bias', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// =========================================================================
// HELPER FUNCTIONS
// =========================================================================
get_size(x) =>
    switch x
        'Auto'   => size.auto
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        => size.small

// =========================================================================
// INPUT SETTINGS
// =========================================================================

// --- MASTER SWITCHES ---
grp_master = 'MASTER VISIBILITY SWITCHES'
showFvg    = input.bool(true, title = 'Show Fair Value Gaps (FVG)', group = grp_master)
showPdhl   = input.bool(true, title = 'Show Previous Day H/L', group = grp_master)
showKz     = input.bool(true, title = 'Show Killzones (Sessions)', group = grp_master)
showNyOpen = input.bool(true, title = 'Show NY Open Line', group = grp_master)
showSmt    = input.bool(true, title = 'Show SMT Divergence (ES/NQ)', group = grp_master)
showOb     = input.bool(true, title = 'Show Order Blocks (OB)', group = grp_master)

// --- FVG SETTINGS ---
grp_fvg = 'FVG SETTINGS'
numFvgToShow = input.int(10, title = 'Total Number of FVG\'s to Show', group = grp_fvg, minval = 1)

grp_color = 'FVG COLORING'
bullFvgColor = input.color(color.new(color.green, 80), title = 'Bullish FVG', group = grp_color)
bearFvgColor = input.color(color.new(color.red, 80), title = 'Bearish FVG', group = grp_color)

// --- PREVIOUS DAY H/L SETTINGS ---
grp_dhl = 'PREVIOUS DAY H/L SETTINGS'
numDaysToShow = input.int(3, title = 'Number of Days to Show H/L', group = grp_dhl, minval = 1)
pdhColor = input.color(color.red, title = 'PDH Color', group = grp_dhl)
pdlColor = input.color(color.green, title = 'PDL Color', group = grp_dhl)

// --- KILLZONE SETTINGS ---
var g_SETTINGS = 'KILLZONE SETTINGS'
kz_max_days = input.int(5, 'Session Drawing Limit', 1, group = g_SETTINGS)
tf_limit = input.timeframe('30', 'Timeframe Limit', group = g_SETTINGS)
gmt_tz = input.string('America/New_York', 'Timezone', options = ['America/New_York', 'GMT-12', 'GMT-11', 'GMT-10', 'GMT-9', 'GMT-8', 'GMT-7', 'GMT-6', 'GMT-5', 'GMT-4', 'GMT-3', 'GMT-2', 'GMT-1', 'GMT+0', 'GMT+1', 'GMT+2', 'GMT+3', 'GMT+4', 'GMT+5', 'GMT+6', 'GMT+7', 'GMT+8', 'GMT+9', 'GMT+10', 'GMT+11', 'GMT+12', 'GMT+13', 'GMT+14'], group = g_SETTINGS)
lbl_size_input = input.string('Small', 'Label Size', options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = g_SETTINGS)
lbl_size = get_size(lbl_size_input)
txt_color = input.color(color.white, 'Text Color', group = g_SETTINGS)

var tf_limit_is_equal_or_more_chart_tf = timeframe.in_seconds('') <= timeframe.in_seconds(tf_limit)

// --- KILLZONE SESSIONS ---
var g_KZ = 'KILLZONE SESSIONS'
kz_style       = input.string('Outline', 'Killzone Style', options = ['Outline', 'Subtle Fill'], group = g_KZ, tooltip = 'Outline = clean border only (see price). Subtle Fill = faint tint.')
kz_fill_transp = input.int(90, 'Subtle Fill Transparency', minval = 80, maxval = 99, group = g_KZ, tooltip = 'Only used with Subtle Fill. Higher = more transparent.')
kz_border_w    = input.int(1, 'Border Width', minval = 1, maxval = 4, group = g_KZ)
show_kz_boxes  = input.bool(true, 'Show Killzone Boxes', inline = 'KZ', group = g_KZ)
show_kz_text   = input.bool(true, 'Display Text', inline = 'KZ', group = g_KZ)

use_asia = input.bool(true, '', inline = 'ASIA', group = g_KZ)
as_txt = input.string('Asia', '', inline = 'ASIA', group = g_KZ)
asia = input.session('1830-0230', '', inline = 'ASIA', group = g_KZ)
as_color = input.color(#2962ff, '', inline = 'ASIA', group = g_KZ)

use_london = input.bool(true, '', inline = 'LONDON', group = g_KZ)
lo_txt = input.string('London', '', inline = 'LONDON', group = g_KZ)
london = input.session('0300-0830', '', inline = 'LONDON', group = g_KZ)
lo_color = input.color(#e91e63, '', inline = 'LONDON', group = g_KZ)

use_ny = input.bool(true, '', inline = 'NY', group = g_KZ)
ny_txt = input.string('NY', '', inline = 'NY', group = g_KZ)
ny_session = input.session('0930-1600', '', inline = 'NY', group = g_KZ)
ny_color = input.color(color.black, '', inline = 'NY', group = g_KZ)

// --- NY OPEN TIME SETTINGS ---
grp_nyopen = 'NY OPEN TIME SETTINGS'
openHour = input.int(14, title = 'Open Hour (London Time)', minval = 0, maxval = 23, group = grp_nyopen)
openMinute = input.int(30, title = 'Open Minute', minval = 0, maxval = 59, group = grp_nyopen)
nyLineColor = input.color(color.red, title = 'Line Color', group = grp_nyopen)
nyLineWidth = input.int(2, title = 'Line Width', minval = 1, maxval = 5, group = grp_nyopen)
nyLineStyleStr = input.string('Solid', title = 'Line Style', options = ['Solid', 'Dashed', 'Dotted'], group = grp_nyopen)

nyLineStyle = switch nyLineStyleStr
    'Dashed' => line.style_dashed
    'Dotted' => line.style_dotted
    => line.style_solid

// --- SMT SETTINGS ---
grp_smt = 'SMT DIVERGENCE'
autoComp     = input.bool(true, 'Auto ES1! <-> NQ1! Pairing', group = grp_smt, tooltip = 'On an ES chart automatically compares against CME_MINI:NQ1!, on an NQ chart against CME_MINI:ES1!. Turn off to use the manual symbol below.')
compSym      = input.symbol('CME_MINI:NQ1!', 'Comparison Symbol (manual)', group = grp_smt, tooltip = 'Only used when Auto Pairing is off.')
smtType      = input.string('Both', 'SMT Type to Show', options = ['Both', 'Bullish', 'Bearish'], group = grp_smt)
maxSmt       = input.int(40, 'Max SMTs Shown (total)', minval = 1, maxval = 200, group = grp_smt)
smtMaxAge    = input.int(300, 'Max Swing Age (bars)', minval = 20, maxval = 2000, group = grp_smt, tooltip = 'Swings older than this are no longer used for new SMT comparisons.')
smtMaxDist   = input.int(150, 'Max Distance Between Paired Swings (bars)', minval = 10, maxval = 2000, group = grp_smt)
fadeInvalid  = input.bool(true, 'Fade Invalidated SMTs', group = grp_smt, tooltip = 'When the holding index later takes the level anyway, the line turns thin, dotted and faded.')
bullCol      = input.color(color.green, 'Bullish Color', group = grp_smt)
bearCol      = input.color(color.red, 'Bearish Color', group = grp_smt)
showSmtLbl   = input.bool(true, 'Show Labels (Major only)', group = grp_smt)
smtLblSizeIn = input.string('Tiny', 'Label Size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = grp_smt)
smtLblSize   = get_size(smtLblSizeIn)

grp_smtM = 'SMT — MAJOR (big swings)'
showMajor = input.bool(true, 'Show Major SMT', group = grp_smtM)
majorLen  = input.int(5, 'Major Pivot Strength', minval = 1, group = grp_smtM, tooltip = 'Bars each side that define a major swing.')
majorW    = input.int(2, 'Major Line Width', minval = 1, maxval = 5, group = grp_smtM)
majorMem  = input.int(10, 'Major Swings Remembered', minval = 1, maxval = 50, group = grp_smtM)

grp_smtN = 'SMT — 2-CANDLE (small swings)'
showMinor   = input.bool(true, 'Show 2-Candle SMT', group = grp_smtN)
minorW      = input.int(1, '2-Candle Line Width', minval = 1, maxval = 5, group = grp_smtN)
minorDotted = input.bool(true, '2-Candle Lines Dotted', group = grp_smtN)
minorMem    = input.int(5, '2-Candle Swings Remembered', minval = 1, maxval = 50, group = grp_smtN)

// --- BOS SETTINGS ---
grp_bos = 'BOS (Break of Structure)'
showBos = input.bool(true, 'Detect BOS', group = grp_bos, tooltip = 'Auto-detect when price closes through the last major swing high/low.')
bosLen  = input.int(5, 'BOS Pivot Strength', minval = 1, group = grp_bos)
drawBos = input.bool(false, 'Draw BOS markers on chart', group = grp_bos)

// --- ORDER BLOCK SETTINGS ---
grp_ob = 'ORDER BLOCKS'
numObShow   = input.int(5, 'Max OBs to Show (each side)', minval = 1, maxval = 20, group = grp_ob)
obBullClr   = input.color(color.new(#00bcd4, 70), 'Bullish OB Color', group = grp_ob)
obBearClr   = input.color(color.new(#ff9800, 70), 'Bearish OB Color', group = grp_ob)
obDispMult  = input.float(1.5, 'Displacement ATR Multiplier', minval = 0.3, maxval = 5.0, step = 0.1, group = grp_ob, tooltip = 'Displacement candle body must exceed this multiple of ATR(14). Lower = more OBs, higher = only strong displacements.')
obLookback  = input.int(5, 'Lookback for OB candle (bars)', minval = 1, maxval = 20, group = grp_ob, tooltip = 'How many bars back to search for the last opposing candle that forms the OB.')

// --- BIAS SETTINGS ---
grp_bias = 'BIAS PANEL'
showBias    = input.bool(true, 'Show Bias Panel', group = grp_bias)
biasPivot   = input.int(5, 'Bias Pivot Length', minval = 2, maxval = 20, group = grp_bias)
biasBullClr = input.color(#00e676, 'Bullish', group = grp_bias)
biasBearClr = input.color(#ff3d57, 'Bearish', group = grp_bias)
biasNeutClr = input.color(#a0a0b8, 'Neutral', group = grp_bias)

// --- CONFLUENCE DASHBOARD ---
grp_dash = 'CONFLUENCE DASHBOARD'
showDash  = input.bool(true, 'Show Dashboard', group = grp_dash)
dashPosIn = input.string('Top Right', 'Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = grp_dash)
dRowSmt   = input.bool(true, 'Row: SMT', group = grp_dash)
dRowFvg   = input.bool(true, 'Row: FVG', group = grp_dash)
dRowIfvg  = input.bool(true, 'Row: iFVG', group = grp_dash)
dRowBos   = input.bool(true, 'Row: BOS', group = grp_dash)
dRowBias  = input.bool(true, 'Row: Bias', group = grp_dash)
dashPos = switch dashPosIn
    'Top Left'     => position.top_left
    'Bottom Right' => position.bottom_right
    'Bottom Left'  => position.bottom_left
    => position.top_right

// =========================================================================
// DATA TYPES & INITIALIZATIONS
// =========================================================================
type FVG
    box id
    bool isActive

var bullFvgs = array.new<FVG>()
var bearFvgs = array.new<FVG>()

type OB
    box  id
    bool isActive

var bullOBs = array.new<OB>()
var bearOBs = array.new<OB>()

type kz
    string _title
    array<box> _box

type kz_helper
    kz _kz
    string session
    color c
    string box_txt

type SMT
    line  ln
    label lb

type Swing
    float price
    float cmp
    int   bar
    bool  chartBroke    = false
    bool  compBroke     = false
    int   chartBrokeBar = na
    int   compBrokeBar  = na
    line  ln = na
    label lb = na

initKZ() =>
    array<kz_helper> res = array.new<kz_helper>()
    if use_asia
        res.push(kz_helper.new(kz.new(as_txt, array.new_box()), asia, as_color, as_txt))
    if use_london
        res.push(kz_helper.new(kz.new(lo_txt, array.new_box()), london, lo_color, lo_txt))
    if use_ny
        res.push(kz_helper.new(kz.new(ny_txt, array.new_box()), ny_session, ny_color, ny_txt))
    res

var array<kz_helper> _kz = initKZ()
var array<SMT> smts = array.new<SMT>()

// confluence state (auto-tracked)
var string fvgDir  = 'None'
var int    fvgBar  = na
var string ifvgDir = 'None'
var int    ifvgBar = na
var string smtDir  = 'None'
var int    smtBar  = na
var string bosDir  = 'None'
var int    bosBar  = na

// =========================================================================
// 1. FVG IDENTIFICATION & DRAWING LOGIC
// =========================================================================
if showFvg
    isBullFvg = low > high[2] and close[1] > open[1]
    isBearFvg = high < low[2] and close[1] < open[1]

    if array.size(bullFvgs) > 0
        for i = array.size(bullFvgs) - 1 to 0 by 1
            fvgItem = array.get(bullFvgs, i)
            if fvgItem.isActive
                if close < box.get_bottom(fvgItem.id)
                    fvgItem.isActive := false
                    box.set_right(fvgItem.id, bar_index)
                    ifvgDir := 'Bearish'
                    ifvgBar := bar_index
                else
                    box.set_right(fvgItem.id, bar_index + 1)

    if array.size(bearFvgs) > 0
        for i = array.size(bearFvgs) - 1 to 0 by 1
            fvgItem = array.get(bearFvgs, i)
            if fvgItem.isActive
                if close > box.get_top(fvgItem.id)
                    fvgItem.isActive := false
                    box.set_right(fvgItem.id, bar_index)
                    ifvgDir := 'Bullish'
                    ifvgBar := bar_index
                else
                    box.set_right(fvgItem.id, bar_index + 1)

    if isBullFvg
        bBox = box.new(left = bar_index[2], top = low, right = bar_index + 1, bottom = high[2], bgcolor = bullFvgColor, border_color = color.new(bullFvgColor, 100))
        array.push(bullFvgs, FVG.new(bBox, true))
        fvgDir := 'Bullish'
        fvgBar := bar_index
        if array.size(bullFvgs) > numFvgToShow
            oldestFvg = array.shift(bullFvgs)
            box.delete(oldestFvg.id)

    if isBearFvg
        sBox = box.new(left = bar_index[2], top = low[2], right = bar_index + 1, bottom = high, bgcolor = bearFvgColor, border_color = color.new(bearFvgColor, 100))
        array.push(bearFvgs, FVG.new(sBox, true))
        fvgDir := 'Bearish'
        fvgBar := bar_index
        if array.size(bearFvgs) > numFvgToShow
            oldestFvg = array.shift(bearFvgs)
            box.delete(oldestFvg.id)

// =========================================================================
// 2. PREVIOUS DAY HIGH/LOW LOGIC
// =========================================================================
pdh = request.security(syminfo.tickerid, 'D', high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, 'D', low[1], lookahead = barmerge.lookahead_on)

isNewDay = ta.change(time('D'))

var pdhLines = array.new_line()
var pdlLines = array.new_line()
var line currentPdhLine = na
var line currentPdlLine = na

if showPdhl
    if bool(isNewDay)
        currentPdhLine := line.new(bar_index, pdh, bar_index + 1, pdh, color = pdhColor, width = 2)
        currentPdlLine := line.new(bar_index, pdl, bar_index + 1, pdl, color = pdlColor, width = 2)

        array.push(pdhLines, currentPdhLine)
        array.push(pdlLines, currentPdlLine)

        if array.size(pdhLines) > numDaysToShow
            line.delete(array.shift(pdhLines))
        if array.size(pdlLines) > numDaysToShow
            line.delete(array.shift(pdlLines))
    else
        if not na(currentPdhLine)
            line.set_x2(currentPdhLine, bar_index + 1)
        if not na(currentPdlLine)
            line.set_x2(currentPdlLine, bar_index + 1)

// =========================================================================
// 3. KILLZONES LOGIC
// =========================================================================
manage_kz(kz_helper this) =>
    kz kz = this._kz
    c = this.c
    string box_txt = this.box_txt

    if tf_limit_is_equal_or_more_chart_tf
        t = not na(time('', this.session, gmt_tz))
        t_prev = not na(time('', this.session, gmt_tz, bars_back = 1))

        if t and not t_prev
            border_c = color.new(c, 0)
            bg_c     = kz_style == 'Subtle Fill' ? color.new(c, kz_fill_transp) : na
            _t       = color.new(txt_color, 0)

            kz._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = show_kz_boxes ? border_c : na, border_width = kz_border_w, bgcolor = show_kz_boxes ? bg_c : na, text = show_kz_boxes and show_kz_text ? box_txt : na, text_color = _t, text_size = lbl_size, text_halign = text.align_left, text_valign = text.align_top))

            if kz._box.size() > kz_max_days
                kz._box.pop().delete()

        if t
            if kz._box.size() > 0
                kzBox0 = kz._box.get(0)
                kzBox0.set_right(time)

                newTop = math.max(kzBox0.get_top(), high)
                kzBox0.set_top(newTop)

                newBottom = math.min(kzBox0.get_bottom(), low)
                kzBox0.set_bottom(newBottom)

if showKz
    for i = 0 to array.size(_kz) - 1 by 1
        manage_kz(array.get(_kz, i))

// =========================================================================
// 4. NY OPEN TIME LOGIC
// =========================================================================
if showNyOpen
    ny_open_time_london = timestamp('Europe/London', year, month, dayofmonth, openHour, openMinute)
    is_ny_open = time == ny_open_time_london
    if is_ny_open
        line.new(x1 = bar_index, y1 = high, x2 = bar_index, y2 = low, color = nyLineColor, width = nyLineWidth, style = nyLineStyle, extend = extend.both)

// =========================================================================
// 5. SMT DIVERGENCE LOGIC (v5 — sweep rule, no dashed preview)
// =========================================================================

isNqChart = str.contains(syminfo.ticker, 'NQ')
isEsChart = str.contains(syminfo.ticker, 'ES')
effCompSym = autoComp and isNqChart ? 'CME_MINI:ES1!' : autoComp and isEsChart ? 'CME_MINI:NQ1!' : compSym

[compHigh, compLow] = request.security(effCompSym, timeframe.period, [high, low])

chartName = syminfo.ticker
compName  = array.last(str.split(effCompSym, ':'))
sameSymWarn = compName == chartName

addSMT(line ln, label lb) =>
    smts.push(SMT.new(ln, lb))
    if smts.size() > maxSmt
        old = smts.shift()
        line.delete(old.ln)
        if not na(old.lb)
            label.delete(old.lb)

pairSMT(Swing s, int b2, float p2, bool isBear, int w, bool dotted, bool withLbl) =>
    col = isBear ? bearCol : bullCol
    st  = dotted ? line.style_dotted : line.style_solid
    line.delete(s.ln)
    label.delete(s.lb)
    s.ln := line.new(s.bar, s.price, b2, p2, color = col, width = w, style = st)
    s.lb := withLbl ? label.new(b2, p2, 'SMT', style = isBear ? label.style_label_down : label.style_label_up, color = color.new(col, 20), textcolor = color.white, size = smtLblSize) : na
    addSMT(s.ln, s.lb)

fadeSMT(Swing s, color baseCol) =>
    if fadeInvalid and not na(s.ln) and array.includes(line.all, s.ln)
        line.set_style(s.ln, line.style_dotted)
        line.set_width(s.ln, 1)
        line.set_color(s.ln, color.new(baseCol, 70))
    if fadeInvalid and not na(s.lb) and array.includes(label.all, s.lb)
        label.set_color(s.lb, color.new(baseCol, 85))
        label.set_textcolor(s.lb, color.new(color.white, 50))

processSMT(bool enabled, simple int len, int w, bool dotted, bool withLbl, int mem) =>
    var array<Swing> shArr = array.new<Swing>()
    var array<Swing> slArr = array.new<Swing>()

    string rDir = na
    int    rBar = na

    ph      = ta.pivothigh(high, len, len)
    pl      = ta.pivotlow(low,  len, len)
    cH      = compHigh[len]
    cL      = compLow[len]
    cHafter = ta.highest(compHigh, len)
    cLafter = ta.lowest(compLow,   len)
    pbar    = bar_index - len

    if enabled
        // update remembered swing highs
        if shArr.size() > 0
            for i = shArr.size() - 1 to 0
                Swing s = shArr.get(i)
                if high > s.price and not s.chartBroke
                    s.chartBroke := true
                    s.chartBrokeBar := bar_index
                if compHigh > s.cmp and not s.compBroke
                    s.compBroke := true
                    s.compBrokeBar := bar_index
                if s.chartBroke and s.compBroke
                    fadeSMT(s, bearCol)
                    shArr.remove(i)
                else if bar_index - s.bar > smtMaxAge
                    shArr.remove(i)

        // update remembered swing lows
        if slArr.size() > 0
            for i = slArr.size() - 1 to 0
                Swing s = slArr.get(i)
                if low < s.price and not s.chartBroke
                    s.chartBroke := true
                    s.chartBrokeBar := bar_index
                if compLow < s.cmp and not s.compBroke
                    s.compBroke := true
                    s.compBrokeBar := bar_index
                if s.chartBroke and s.compBroke
                    fadeSMT(s, bullCol)
                    slArr.remove(i)
                else if bar_index - s.bar > smtMaxAge
                    slArr.remove(i)

        // new confirmed swing HIGH: pair with freshly-swept level
        if not na(ph)
            if shArr.size() > 0 and (smtType == 'Both' or smtType == 'Bearish')
                int bestIdx = -1
                float bestPrice = na
                for i = 0 to shArr.size() - 1
                    Swing s = shArr.get(i)
                    bool chartSweep = ph > s.price and cH < s.cmp
                    bool compSweep  = ph < s.price and cH > s.cmp
                    bool fresh = chartSweep ? not na(s.chartBrokeBar) and bar_index - s.chartBrokeBar <= 2 * len : compSweep ? not na(s.compBrokeBar) and bar_index - s.compBrokeBar <= 2 * len : false
                    if (chartSweep or compSweep) and fresh and pbar - s.bar <= smtMaxDist
                        if na(bestPrice) or s.price > bestPrice
                            bestPrice := s.price
                            bestIdx := i
                if bestIdx != -1
                    pairSMT(shArr.get(bestIdx), pbar, ph, true, w, dotted, withLbl)
                    rDir := 'Bearish'
                    rBar := pbar
            Swing newH = Swing.new(ph, cH, pbar)
            if cHafter > cH
                newH.compBroke := true
                newH.compBrokeBar := bar_index
            shArr.push(newH)
            if shArr.size() > mem
                shArr.shift()

        // new confirmed swing LOW: pair with freshly-swept level
        if not na(pl)
            if slArr.size() > 0 and (smtType == 'Both' or smtType == 'Bullish')
                int bestIdx = -1
                float bestPrice = na
                for i = 0 to slArr.size() - 1
                    Swing s = slArr.get(i)
                    bool chartSweep = pl < s.price and cL > s.cmp
                    bool compSweep  = pl > s.price and cL < s.cmp
                    bool fresh = chartSweep ? not na(s.chartBrokeBar) and bar_index - s.chartBrokeBar <= 2 * len : compSweep ? not na(s.compBrokeBar) and bar_index - s.compBrokeBar <= 2 * len : false
                    if (chartSweep or compSweep) and fresh and pbar - s.bar <= smtMaxDist
                        if na(bestPrice) or s.price < bestPrice
                            bestPrice := s.price
                            bestIdx := i
                if bestIdx != -1
                    pairSMT(slArr.get(bestIdx), pbar, pl, false, w, dotted, withLbl)
                    rDir := 'Bullish'
                    rBar := pbar
            Swing newL = Swing.new(pl, cL, pbar)
            if cLafter < cL
                newL.compBroke := true
                newL.compBrokeBar := bar_index
            slArr.push(newL)
            if slArr.size() > mem
                slArr.shift()

    [rDir, rBar]

[mjDir, mjBar] = processSMT(showSmt and showMajor, majorLen, majorW, false, showSmtLbl, majorMem)
[mnDir, mnBar] = processSMT(showSmt and showMinor, 1, minorW, minorDotted, false, minorMem)

if not na(mjBar)
    smtDir := mjDir
    smtBar := mjBar
else if not na(mnBar)
    smtDir := mnDir
    smtBar := mnBar

// =========================================================================
// 6. BOS — BREAK OF STRUCTURE
// =========================================================================
bph = ta.pivothigh(high, bosLen, bosLen)
bpl = ta.pivotlow(low,  bosLen, bosLen)

var float swingHigh = na
var float swingLow  = na
if not na(bph)
    swingHigh := bph
if not na(bpl)
    swingLow := bpl

bullBOS = showBos and not na(swingHigh) and ta.crossover(close, swingHigh)
bearBOS = showBos and not na(swingLow)  and ta.crossunder(close, swingLow)

if bullBOS
    bosDir := 'Bullish'
    bosBar := bar_index
    if drawBos
        line.new(bar_index - 1, swingHigh, bar_index, swingHigh, color = bullCol, width = 1, style = line.style_dotted)
        label.new(bar_index, swingHigh, 'BOS', style = label.style_label_down, color = color.new(bullCol, 20), textcolor = color.white, size = size.tiny)
if bearBOS
    bosDir := 'Bearish'
    bosBar := bar_index
    if drawBos
        line.new(bar_index - 1, swingLow, bar_index, swingLow, color = bearCol, width = 1, style = line.style_dotted)
        label.new(bar_index, swingLow, 'BOS', style = label.style_label_up, color = color.new(bearCol, 20), textcolor = color.white, size = size.tiny)

// =========================================================================
// 7. ORDER BLOCKS
// =========================================================================
// Bullish OB: last bearish candle before a bullish displacement.
// Bearish OB: last bullish candle before a bearish displacement.
// Box covers the body only (open → close), extends right until mitigated.

obAtr = ta.atr(14)

if showOb
    // Only mark an OB when the displacement is the move that actually breaks
    // structure (BOS) — filters out big-bodied candles that occur mid-trend
    // with nothing new broken.
    bullDisp = (close - open) > obDispMult * obAtr and close > open and bullBOS
    bearDisp = (open - close) > obDispMult * obAtr and close < open and bearBOS

    // extend / mitigate existing OBs every bar
    if bullOBs.size() > 0
        for i = bullOBs.size() - 1 to 0 by 1
            ob = bullOBs.get(i)
            if ob.isActive
                if close < box.get_bottom(ob.id)
                    ob.isActive := false
                    box.set_right(ob.id, bar_index)
                else
                    box.set_right(ob.id, bar_index + 1)

    if bearOBs.size() > 0
        for i = bearOBs.size() - 1 to 0 by 1
            ob = bearOBs.get(i)
            if ob.isActive
                if close > box.get_top(ob.id)
                    ob.isActive := false
                    box.set_right(ob.id, bar_index)
                else
                    box.set_right(ob.id, bar_index + 1)

    // new bullish displacement → find last bearish body (OB)
    if bullDisp
        int obIdx = -1
        for i = 1 to obLookback
            if close[i] < open[i]
                obIdx := i
                break
        if obIdx != -1
            obTop = math.max(open[obIdx], close[obIdx])
            obBot = low[obIdx]
            b = box.new(bar_index - obIdx, obTop, bar_index + 1, obBot, bgcolor = obBullClr, border_color = color.new(#00bcd4, 20), border_width = 1)
            label.new(bar_index - obIdx, obTop, 'OB', style = label.style_label_down, color = color.new(#00bcd4, 30), textcolor = color.white, size = size.tiny)
            bullOBs.push(OB.new(b, true))
            if bullOBs.size() > numObShow
                old = bullOBs.shift()
                box.delete(old.id)

    // new bearish displacement → find last bullish body (OB)
    if bearDisp
        int obIdx = -1
        for i = 1 to obLookback
            if close[i] > open[i]
                obIdx := i
                break
        if obIdx != -1
            obTop = high[obIdx]
            obBot = math.min(open[obIdx], close[obIdx])
            b = box.new(bar_index - obIdx, obTop, bar_index + 1, obBot, bgcolor = obBearClr, border_color = color.new(#ff9800, 20), border_width = 1)
            label.new(bar_index - obIdx, obBot, 'OB', style = label.style_label_up, color = color.new(#ff9800, 30), textcolor = color.white, size = size.tiny)
            bearOBs.push(OB.new(b, true))
            if bearOBs.size() > numObShow
                old = bearOBs.shift()
                box.delete(old.id)

// =========================================================================
// 8. HTF BIAS — 1H / 4H / Daily (only updates on candle close)
// =========================================================================

calc_htf_bias(simple int pvt) =>
    _ph = ta.pivothigh(high, pvt, pvt)
    _pl = ta.pivotlow(low, pvt, pvt)

    var float _sh1 = na, var float _sh0 = na
    var float _sl1 = na, var float _sl0 = na

    if not na(_ph)
        _sh1 := _sh0
        _sh0 := _ph
    if not na(_pl)
        _sl1 := _sl0
        _sl0 := _pl

    _hh = not na(_sh0) and not na(_sh1) and _sh0 > _sh1
    _hl = not na(_sl0) and not na(_sl1) and _sl0 > _sl1
    _lh = not na(_sh0) and not na(_sh1) and _sh0 < _sh1
    _ll = not na(_sl0) and not na(_sl1) and _sl0 < _sl1
    _struct = (_hh ? 1.0 : _lh ? -1.0 : 0.0) + (_hl ? 1.0 : _ll ? -1.0 : 0.0)

    var int _bos = 0
    if not na(_sh0) and close > _sh0 and close[1] <= _sh0
        _bos := 1
    if not na(_sl0) and close < _sl0 and close[1] >= _sl0
        _bos := -1

    _bull_fvg = low > high[2] and close[1] > open[1]
    _bear_fvg = high < low[2] and close[1] < open[1]

    var float _bf_top = na, var float _bf_bot = na
    var float _sf_top = na, var float _sf_bot = na

    if _bull_fvg
        _bf_top := low
        _bf_bot := high[2]
    if _bear_fvg
        _sf_top := low[2]
        _sf_bot := high

    _bf_resp = not na(_bf_bot) and low <= _bf_top and close > _bf_bot
    _bf_dis  = not na(_bf_bot) and close < _bf_bot
    _sf_resp = not na(_sf_top) and high >= _sf_bot and close < _sf_top
    _sf_dis  = not na(_sf_top) and close > _sf_top

    if _bf_dis
        _bf_top := na
        _bf_bot := na
    if _sf_dis
        _sf_top := na
        _sf_bot := na

    _fvg_s = (_bf_resp ? 1.5 : _bf_dis ? -1.5 : 0.0) + (_sf_resp ? -1.5 : _sf_dis ? 1.5 : 0.0)

    var int _sw = 0
    if not na(_sl0) and low < _sl0 and close > _sl0
        _sw := 1
    if not na(_sh0) and high > _sh0 and close < _sh0
        _sw := -1

    _body = math.abs(close - open)
    _rng  = high - low
    _disp = _rng > 0 ? _body / _rng : 0.0
    _ds   = _disp > 0.7 ? (close > open ? 0.5 : -0.5) : 0.0

    _total = _struct + _bos * 2.0 + _fvg_s + _sw * 1.5 + _ds
    _bias  = _total > 0.5 ? 1 : _total < -0.5 ? -1 : 0

    [_bias, _struct, _bos, _fvg_s > 0 ? 1 : _fvg_s < 0 ? -1 : 0, _sw]

[h1_bias, h1_struct, h1_bos, h1_fvg, h1_sweep]  = request.security(syminfo.tickerid, '60',  calc_htf_bias(biasPivot))
[h4_bias, h4_struct, h4_bos, h4_fvg, h4_sweep]   = request.security(syminfo.tickerid, '240', calc_htf_bias(biasPivot))
[d_bias, d_struct, d_bos, d_fvg, d_sweep]         = request.security(syminfo.tickerid, 'D',   calc_htf_bias(biasPivot))

f_bias_str(int b) => b == 1 ? 'BULLISH' : b == -1 ? 'BEARISH' : 'NEUTRAL'
f_bias_dir(int b) => b == 1 ? 'Bullish' : b == -1 ? 'Bearish' : 'None'
f_struct_str(float s) => s > 1.5 ? 'HH + HL' : s > 0 ? 'HH or HL' : s < -1.5 ? 'LH + LL' : s < 0 ? 'LH or LL' : 'Ranging'
f_bos_str(int b) => b == 1 ? 'Bull BOS' : b == -1 ? 'Bear BOS' : '–'
f_fvg_str(int f) => f == 1 ? 'Respected' : f == -1 ? 'Disrespected' : '–'
f_sweep_str(int s) => s == 1 ? 'SSL Swept' : s == -1 ? 'BSL Swept' : '–'

bp_bias_str = f_bias_str(h1_bias)
bp_bias_dir = f_bias_dir(h1_bias)

// =========================================================================
// 9. CONFLUENCE DASHBOARD (Top) + BIAS PANEL (Bottom)
// =========================================================================
agoStr(int b) => na(b) ? '' : ' (' + str.tostring(bar_index - b) + ')'
confCol(string dir) => dir == 'Bullish' ? bullCol : dir == 'Bearish' ? bearCol : color.gray
confTxt(string dir, int b) => dir == 'None' ? '–' : dir + agoStr(b)

biasCol(string dir) => dir == 'Bullish' ? biasBullClr : dir == 'Bearish' ? biasBearClr : biasNeutClr

var table dash = table.new(dashPos, 2, 7, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

if showDash and barstate.islast
    table.cell(dash, 0, 0, 'CONFLUENCE', text_color = color.white, text_size = size.normal, bgcolor = color.new(color.black, 0))
    table.cell(dash, 1, 0, chartName + ' / ' + compName + (sameSymWarn ? ' ⚠' : ''), text_color = sameSymWarn ? color.red : color.white, text_size = size.small, bgcolor = color.new(color.black, 0), tooltip = sameSymWarn ? 'Comparison symbol is the SAME as the chart — SMT impossible. Enable Auto Pairing or set a different symbol.' : na)

    int r = 1
    if dRowSmt
        table.cell(dash, 0, r, 'SMT', text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 20))
        table.cell(dash, 1, r, confTxt(smtDir, smtBar), text_color = color.white, text_size = size.small, bgcolor = color.new(confCol(smtDir), 20))
        r += 1
    if dRowFvg
        table.cell(dash, 0, r, 'FVG', text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 20))
        table.cell(dash, 1, r, confTxt(fvgDir, fvgBar), text_color = color.white, text_size = size.small, bgcolor = color.new(confCol(fvgDir), 20))
        r += 1
    if dRowIfvg
        table.cell(dash, 0, r, 'iFVG', text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 20))
        table.cell(dash, 1, r, confTxt(ifvgDir, ifvgBar), text_color = color.white, text_size = size.small, bgcolor = color.new(confCol(ifvgDir), 20))
        r += 1
    if dRowBos
        table.cell(dash, 0, r, 'BOS', text_color = color.silver, text_size = size.small, bgcolor = color.new(color.black, 20))
        table.cell(dash, 1, r, confTxt(bosDir, bosBar), text_color = color.white, text_size = size.small, bgcolor = color.new(confCol(bosDir), 20))
        r += 1
    if dRowBias
        table.cell(dash, 0, r, timeframe.period + ' BIAS', text_color = #ffd700, text_size = size.small, bgcolor = color.new(color.black, 20))
        table.cell(dash, 1, r, bp_bias_str, text_color = color.white, text_size = size.small, bgcolor = color.new(biasCol(bp_bias_dir), 20))
        r += 1

// --- Bias Detail Panel (bottom) – 1H / 4H / Daily ---
biasBottomPos = dashPos == position.top_right ? position.bottom_right : dashPos == position.top_left ? position.bottom_left : dashPos == position.bottom_right ? position.bottom_left : position.bottom_right

var table biasTbl = table.new(biasBottomPos, 6, 4, border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

biasRowCol(int b) => b == 1 ? biasBullClr : b == -1 ? biasBearClr : biasNeutClr

if showBias and barstate.islast
    table.cell(biasTbl, 0, 0, 'TF',        text_color = #ffd700,     text_size = size.small, bgcolor = color.new(color.black, 0))
    table.cell(biasTbl, 1, 0, 'Bias',       text_color = #ffd700,     text_size = size.small, bgcolor = color.new(color.black, 0))
    table.cell(biasTbl, 2, 0, 'Structure',  text_color = color.silver, text_size = size.tiny,  bgcolor = color.new(color.black, 0))
    table.cell(biasTbl, 3, 0, 'BOS',        text_color = color.silver, text_size = size.tiny,  bgcolor = color.new(color.black, 0))
    table.cell(biasTbl, 4, 0, 'FVG',        text_color = color.silver, text_size = size.tiny,  bgcolor = color.new(color.black, 0))
    table.cell(biasTbl, 5, 0, 'Sweep',      text_color = color.silver, text_size = size.tiny,  bgcolor = color.new(color.black, 0))

    table.cell(biasTbl, 0, 1, '1H',                  text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 1, 1, f_bias_str(h1_bias),   text_color = biasRowCol(h1_bias), text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 2, 1, f_struct_str(h1_struct), text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h1_struct > 0 ? 1 : h1_struct < 0 ? -1 : 0), 40))
    table.cell(biasTbl, 3, 1, f_bos_str(h1_bos),     text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h1_bos), 40))
    table.cell(biasTbl, 4, 1, f_fvg_str(h1_fvg),     text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h1_fvg), 40))
    table.cell(biasTbl, 5, 1, f_sweep_str(h1_sweep),  text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h1_sweep), 40))

    table.cell(biasTbl, 0, 2, '4H',                  text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 1, 2, f_bias_str(h4_bias),   text_color = biasRowCol(h4_bias), text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 2, 2, f_struct_str(h4_struct), text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h4_struct > 0 ? 1 : h4_struct < 0 ? -1 : 0), 40))
    table.cell(biasTbl, 3, 2, f_bos_str(h4_bos),     text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h4_bos), 40))
    table.cell(biasTbl, 4, 2, f_fvg_str(h4_fvg),     text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h4_fvg), 40))
    table.cell(biasTbl, 5, 2, f_sweep_str(h4_sweep),  text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(h4_sweep), 40))

    table.cell(biasTbl, 0, 3, '1D',                  text_color = color.white, text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 1, 3, f_bias_str(d_bias),    text_color = biasRowCol(d_bias), text_size = size.small, bgcolor = color.new(color.black, 20))
    table.cell(biasTbl, 2, 3, f_struct_str(d_struct),  text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(d_struct > 0 ? 1 : d_struct < 0 ? -1 : 0), 40))
    table.cell(biasTbl, 3, 3, f_bos_str(d_bos),      text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(d_bos), 40))
    table.cell(biasTbl, 4, 3, f_fvg_str(d_fvg),      text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(d_fvg), 40))
    table.cell(biasTbl, 5, 3, f_sweep_str(d_sweep),   text_color = color.white, text_size = size.tiny, bgcolor = color.new(biasRowCol(d_sweep), 40))

// =========================================================================
// 10. ALERTS
// =========================================================================
alertPh = ta.pivothigh(high, 1, 1)
alertPl = ta.pivotlow(low, 1, 1)
alertcondition(not na(alertPh), 'Possible Bearish SMT', 'Swing high formed - check SMT')
alertcondition(not na(alertPl), 'Possible Bullish SMT', 'Swing low formed - check SMT')
alertcondition(bullBOS, 'Bullish BOS', 'Break of structure up')
alertcondition(bearBOS, 'Bearish BOS', 'Break of structure down')
